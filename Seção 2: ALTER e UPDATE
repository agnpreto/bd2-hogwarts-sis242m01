-- Questão 8
UPDATE matricula
SET nota = LEAST(nota + 0.5, 10)
WHERE id_disc IN (SELECT id_disc
                  FROM disciplina
                  WHERE id_prof = (SELECT id_prof
                                   FROM professor
                                   WHERE nome = 'Remo Lupin'));

